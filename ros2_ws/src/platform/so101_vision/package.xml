<?xml version="1.0"?>
<package format="3">
  <name>so101_vision</name>
  <version>1.0.0</version>
  <description>Monocular camera geometry (pixel to 3D on a plane), colour segmentation and occlusion-robust tracking.</description>
  <maintainer email="neo.burtin@epitech.eu">neo</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
