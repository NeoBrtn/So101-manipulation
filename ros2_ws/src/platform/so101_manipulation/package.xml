<?xml version="1.0"?>
<package format="3">
  <name>so101_manipulation</name>
  <version>1.0.0</version>
  <description>Kinematics (Pinocchio CLIK), trajectory streaming and arm utilities of the SO-101, shared by every task.</description>
  <maintainer email="neo.burtin@epitech.eu">neo</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>so101_interfaces</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>so101_description</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
