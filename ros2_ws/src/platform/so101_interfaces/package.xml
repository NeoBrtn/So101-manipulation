<?xml version="1.0"?>
<package format="3">
  <name>so101_interfaces</name>
  <version>1.0.0</version>
  <description>Services of the SO-101 platform (ament_cmake: rosidl generation is not available to ament_python packages).</description>
  <maintainer email="neo.burtin@epitech.eu">neo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>geometry_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
