# Copy to docker/.env and edit:  cp .env.example .env

# ROS 2 domain (0-101): use a distinct value per group sharing a network
ROS_DOMAIN_ID=42

# Task package to run (ros2_ws/src/tasks/so101_<TASK>): pick_place | decap
TASK=pick_place

# true: MuJoCo digital twin, false: real arm
USE_SIM=true

# Simulation: live MuJoCo window (needs X11: xhost +local:docker)
SIM_VIEWER=false

# ---- Real arm (USE_SIM=false) ------------------------------------------------------

# Serial port. Find it by plugging/unplugging the arm while running:
#   sudo udevadm monitor --subsystem-match=tty --property | grep --line-buffered -E "(DEVNAME=|ACTION=)"
REAL_ROBOT_PORT=/dev/ttyACM0

# LeRobot calibration file of the arm (lerobot-calibrate), mounted read-only
CALIBRATION_FILE=~/.cache/huggingface/lerobot/calibration/robots/so_follower/my_follower_arm.json

# true: torque off, the driver only publishes /joint_states (move the arm by hand)
PASSIVE=false

# Network camera, e.g. DroidCam on a phone: http://<phone-ip>:4747/video
CAMERA_URL=
# Its pose is estimated live from an ArUco marker (4x4, id 0) lying flat on the table,
# TOP of the print pointing away from the robot: centre "x y" (m, robot frame) and size.
# Print it: ros2 run so101_driver calibrate_camera marker --marker-size 0.10
MARKER_XY=
MARKER_SIZE=0.10
